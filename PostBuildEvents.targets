<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="Configurations.targets" Condition="Exists('Configurations.targets')" />

  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
    <ModFolder Condition="'$(ModFolder)' == '' and '$(Configuration)' == 'SN'">D:\Steam\steamapps\common\Subnautica\BepInEx\plugins</ModFolder>
    <ModFolder Condition="'$(ModFolder)' == '' and '$(Configuration)' == 'BZ'">D:\Steam\steamapps\common\SubnauticaZero\BepInEx\plugins</ModFolder>
  </PropertyGroup>

  <Target Name="CustomPostBuild" AfterTargets="Build" Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <Exec Command="
mkdir &quot;$(ModFolder)\$(TargetName).$(Configuration)&quot;
mkdir &quot;$(ModFolder)\$(TargetName).$(Configuration)\Assets&quot;

copy /Y &quot;$(TargetPath)&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\&quot;
if exist &quot;$(ProjectDir)mod.json&quot; copy /Y &quot;$(ProjectDir)mod.json&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\&quot;
if exist &quot;$(ProjectDir)Assets\*.asset&quot; copy /Y &quot;$(ProjectDir)Assets\*.asset&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\Assets\&quot;
if exist &quot;$(ProjectDir)Assets\*.manifest&quot; copy /Y &quot;$(ProjectDir)Assets\*.manifest&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\Assets\&quot;
if exist &quot;$(ProjectDir)Assets\*.png&quot; copy /Y &quot;$(ProjectDir)Assets\*.png&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\Assets\&quot;

:: Copy AD3D_Common and its Assets if they exist in the target dir
if exist &quot;$(TargetDir)AD3D_Common.dll&quot; copy /Y &quot;$(TargetDir)AD3D_Common.dll&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\&quot;
if exist &quot;$(TargetDir)Assets\*.asset&quot; copy /Y &quot;$(TargetDir)Assets\*.asset&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\Assets\&quot;
if exist &quot;$(TargetDir)Assets\*.manifest&quot; copy /Y &quot;$(TargetDir)Assets\*.manifest&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\Assets\&quot;
if exist &quot;$(TargetDir)Assets\*.png&quot; copy /Y &quot;$(TargetDir)Assets\*.png&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\Assets\&quot;

:: Zip creation
if not exist &quot;$(SolutionDir)Download\$(Configuration)&quot; mkdir &quot;$(SolutionDir)Download\$(Configuration)&quot;
set &quot;SEVENZIP=C:\Program Files\7-Zip\7z.exe&quot;
if exist &quot;%SEVENZIP%&quot; (
  &quot;%SEVENZIP%&quot; a -tzip &quot;$(SolutionDir)Download\$(Configuration)\$(TargetName).$(Configuration).zip&quot; &quot;$(ModFolder)\$(TargetName).$(Configuration)\*&quot; -mx9 -y
) else (
  echo WARNING: 7z.exe not found at %SEVENZIP%. Skipping zip creation.
)
    " />
  </Target>

  <!-- CI packaging: GitHub Actions has no game install and no 7-Zip, so CustomPostBuild
       is skipped there. This stages the exact same payload the local zip ships (mod DLL +
       AD3D_Common.dll at the root, Assets/*.asset|*.manifest|*.png under Assets/) into a
       repo-relative folder the workflow zips. SolutionDir is passed explicitly by the
       workflow because a per-csproj build doesn't set it. -->
  <Target Name="StageForPackaging" AfterTargets="Build" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PropertyGroup>
      <CiStageDir>$(SolutionDir)artifacts\$(Configuration)\$(TargetName).$(Configuration)</CiStageDir>
    </PropertyGroup>
    <ItemGroup>
      <CiBinary Include="$(TargetPath)" />
      <CiBinary Include="$(TargetDir)AD3D_Common.dll" Condition="Exists('$(TargetDir)AD3D_Common.dll')" />
      <CiModJson Include="$(ProjectDir)mod.json" Condition="Exists('$(ProjectDir)mod.json')" />
      <CiAsset Include="$(ProjectDir)Assets\*.asset" />
      <CiAsset Include="$(ProjectDir)Assets\*.manifest" />
      <CiAsset Include="$(ProjectDir)Assets\*.png" />
    </ItemGroup>
    <RemoveDir Directories="$(CiStageDir)" />
    <Copy SourceFiles="@(CiBinary)" DestinationFolder="$(CiStageDir)" />
    <Copy SourceFiles="@(CiModJson)" DestinationFolder="$(CiStageDir)" Condition="'@(CiModJson)' != ''" />
    <Copy SourceFiles="@(CiAsset)" DestinationFolder="$(CiStageDir)\Assets" Condition="'@(CiAsset)' != ''" />
  </Target>
</Project>